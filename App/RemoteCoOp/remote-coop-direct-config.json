{
  "remoteCoOpConfig": {
    "version": "4.0",
    "topology": "websocket-signaling-with-direct-or-turn-media",
    "latencyMode": "lowLatency",
    "qualityPreset": "p720f60",
    "maxBitrateBps": 12000000,
    "networkConfiguration": {
      "iceTransportPolicy": "all",
      "iceServers": [
        {
          "urls": [
            "stun:stun.l.google.com:19302",
            "stun:stun1.l.google.com:19302"
          ]
        }
      ],
      "signalingURL": "wss://jayian.dev:38473/remote-coop-direct",
      "turn": {
        "host": "jayian.dev",
        "udpTcpPort": 38474,
        "tlsTcpPort": 38475,
        "relayUDPPortRange": [40000, 40100],
        "credentials": "room-scoped-time-limited"
      },
      "dataChannelInputEnabled": true,
      "websocketInputFallbackEnabled": false
    },
    "admission": {
      "roomCodeLength": 6,
      "hostAuthoritative": true,
      "inviteLifetimeSeconds": 3600,
      "maxGuestSlots": 3
    },
    "signaling": {
      "method": "websocket",
      "serverRequired": true,
      "publicURL": "wss://jayian.dev:38473/remote-coop-direct",
      "hostPort": 32190
    },
    "failurePolicy": {
      "directConnectionPreferred": true,
      "turnRelayFallback": true
    }
  }
}
