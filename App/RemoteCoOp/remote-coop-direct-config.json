{
  "remoteCoOpConfig": {
    "version": "2.0",
    "topology": "relayless-peer-to-peer",
    "latencyMode": "lowLatency",
    "qualityPreset": "p720f60",
    "maxBitrateBps": 12000000,
    "networkConfiguration": {
      "iceTransportPolicy": "all",
      "iceServers": [
        {
          "urls": [
            "stun:stun.l.google.com:19302",
            "stun:stun1.l.google.com:19302"
          ]
        }
      ],
      "dataChannelInputEnabled": true,
      "websocketInputFallbackEnabled": false
    },
    "discovery": {
      "bonjour": true,
      "upnp": true,
      "signalingPort": 32189
    },
    "admission": {
      "roomCodeLength": 6,
      "hostAuthoritative": true,
      "inviteLifetimeSeconds": 3600,
      "maxGuestSlots": 3
    },
    "signaling": {
      "path": "/remote-coop-direct",
      "protocol": "ws-or-wss",
      "role": "rendezvous-only"
    },
    "failurePolicy": {
      "directConnectionRequired": true,
      "silentAlternatePath": false
    }
  }
}
